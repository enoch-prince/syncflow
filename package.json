{
  "name": "@syncflow/core",
  "version": "0.3.0",
  "description": "Local-first database with event sourcing and vector clock synchronization. Flow seamlessly between local and cloud.",
  "keywords": [
    "local-first",
    "offline-first",
    "database",
    "sync",
    "event-sourcing",
    "vector-clocks",
    "crdt",
    "indexeddb",
    "sqlite",
    "wasm",
    "real-time",
    "collaboration",
    "syncflow"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "homepage": "https://syncflow.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/enoch-prince/syncflow.git"
  },
  "bugs": {
    "url": "https://github.com/enoch-prince/syncflow/issues"
  },
  "main": "dist/src/index.js",
  "module": "dist/src/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./adapters/mongodb": {
      "import": "./dist/server/mongo-adapter.mjs",
      "require": "./dist/server/mongo-adapter.js",
      "types": "./dist/server/mongo-adapter.d.ts"
    },
    "./adapters/postgres": {
      "import": "./dist/server/postgres-adapter.mjs",
      "require": "./dist/server/postgres-adapter.js",
      "types": "./dist/server/postgres-adapter.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"['dist','dist-esm'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir dist",
    "build:esm": "tsc --module esnext --outDir dist-esm && node scripts/build-esm.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "npm run build",
    "test": "echo \"Tests coming soon\"",
    "release": "npm run build && npm publish --access public"
  },
  "peerDependencies": {
    "wa-sqlite": "^0.9.9"
  },
  "peerDependenciesMeta": {
    "wa-sqlite": {
      "optional": true
    }
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongodb": "^6.3.0",
    "pg": "^8.11.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
